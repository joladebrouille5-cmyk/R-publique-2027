{
  "name": "republique-2027",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @r2027/api --filter @r2027/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.e2e.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "pnpm --filter @r2027/api run test:integration",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test -c playwright.mobile.config.ts",
    "mobile:apk": "pnpm --filter @r2027/mobile run android:apk",
    "db:migrate": "pnpm --filter @r2027/api run db:migrate",
    "db:deploy": "pnpm --filter @r2027/api run db:deploy",
    "data:geo": "pnpm --filter @r2027/data-import run geo",
    "data:resultats": "pnpm --filter @r2027/data-import run resultats",
    "data:personnalites": "pnpm --filter @r2027/data-import run personnalites",
    "data:gouvernement": "pnpm --filter @r2027/data-import run gouvernement",
    "data:medias": "pnpm --filter @r2027/data-import run medias",
    "data:assemblee": "pnpm --filter @r2027/data-import run assemblee",
    "data:economie": "pnpm --filter @r2027/data-import run economie",
    "data:legislatives": "pnpm --filter @r2027/data-import run legislatives",
    "data:sons": "pnpm --filter @r2027/data-import run sons",
    "data:scenes": "pnpm --filter @r2027/data-import run scenes",
    "mesure:carte": "node scripts/spike-carte/spike.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "sim:equilibrage": "pnpm --filter @r2027/engine exec tsx scripts/sim-equilibrage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
