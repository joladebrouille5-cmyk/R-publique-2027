# Copier ce fichier en .env (ignoré par Git) et adapter les valeurs.
# Aucune valeur ci-dessous n'est un secret de production.

# Base PostgreSQL de développement (docker compose ou scripts/pg-local.sh).
DATABASE_URL=postgresql://postgres:r2027_dev@localhost:5432/r2027
# Base dédiée aux tests d'intégration (vidée à chaque exécution).
DATABASE_URL_TEST=postgresql://postgres:r2027_dev@localhost:5432/r2027_test

# Clé de signature des cookies de session : au moins 32 caractères.
# En production, la générer (ex. `openssl rand -base64 48`) et la définir chez l'hébergeur.
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-d-au-moins-32-caracteres

# Serveur API
API_HOST=127.0.0.1
API_PORT=3001
# Requêtes autorisées par adresse IP et par minute.
RATE_LIMIT_MAX=300

# Référentiel cartographique servi par l'API (facultatif). Par défaut : l'import complet
# (data/processed/geo/cog-2026, produit par `pnpm data:geo`), sinon le jeu de démonstration
# commité (packages/data-import/demo/cog-2026). À définir en production (chemin absolu).
# GEO_DATA_DIR=/chemin/vers/data/processed/geo/cog-2026
# Résultats historiques importés par `pnpm data:resultats` (facultatif ; par défaut
# data/processed/resultats/presidentielle-2022). Utilisés seulement avec le référentiel complet.
# RESULTS_DATA_DIR=/chemin/vers/data/processed/resultats/presidentielle-2022
